<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.register.RegisterFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img_login"
            android:layout_width="@dimen/_72sdp"
            android:layout_height="@dimen/_72sdp"
            android:src="@drawable/img_login"
            android:layout_marginTop="@dimen/_96sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:id="@+id/welcome_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to_lafyuu"
            android:textColor="@color/natural_dark"
            android:textSize="@dimen/_16ssp"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing=".031"
            android:lineHeight="@dimen/_24ssp"
            android:layout_marginTop="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@id/img_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:id="@+id/sign_in_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_in_to_continue"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/poppins_regular"
            android:lineHeight="@dimen/_21ssp"
            android:letterSpacing=".031"
            app:layout_constraintTop_toBottomOf="@id/welcome_txt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/name_text"
            style="@style/custom_edit_text"
            android:drawableStart="@drawable/custom_user_icon"
            android:hint="@string/full_name"
            android:inputType="text"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_in_txt"/>
        <EditText
            android:id="@+id/email_text"
            style="@style/custom_edit_text"
            android:drawableStart="@drawable/custom_email_icon"
            android:hint="@string/your_email"
            android:inputType="textEmailAddress"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name_text"/>
        <EditText
            android:id="@+id/password_text"
            style="@style/custom_edit_text"
            android:drawableStart="@drawable/custom_password_icon"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/email_text"/>
        <EditText
            android:id="@+id/password_again_text"
            style="@style/custom_edit_text"
            android:drawableStart="@drawable/custom_password_icon"
            android:hint="@string/password_again"
            android:inputType="textPassword"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/password_text"/>
        <Button
            android:id="@+id/sign_up_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_up"
            android:textAllCaps="false"
            android:padding="@dimen/_12sdp"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing=".031"
            android:lineHeight="@dimen/_21ssp"
            android:backgroundTint="@color/primary_color"
            android:layout_margin="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/password_again_text"/>
        <TextView
            android:id="@+id/have_accont_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:text="@string/have_an_account"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/poppins_regular"
            android:letterSpacing=".031"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sign_up_btn"
            app:layout_constraintEnd_toStartOf="@id/sign_in_label"/>
        <TextView
            android:id="@+id/sign_in_label"
            style="@style/custom_text_clickable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_in"
            app:layout_constraintStart_toEndOf="@id/have_accont_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/have_accont_label"
            app:layout_constraintBottom_toBottomOf="@id/have_accont_label"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>