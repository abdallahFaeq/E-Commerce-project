<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.training.ecommercetrainingproject.ui.auth.login.LoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.auth.login.LoginFragment">
        <ScrollView
            android:id="@+id/login_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/img_login"
                    android:layout_width="@dimen/_72sdp"
                    android:layout_height="@dimen/_72sdp"
                    android:src="@drawable/img_login"
                    android:layout_marginTop="@dimen/_60sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:id="@+id/welcome_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_to_lafyuu"
                    android:textColor="@color/natural_dark"
                    android:textSize="@dimen/_16ssp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing=".031"
                    android:lineHeight="@dimen/_24ssp"
                    android:layout_marginTop="@dimen/_20sdp"
                    app:layout_constraintTop_toBottomOf="@id/img_login"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:id="@+id/sign_in_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in_to_continue"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/poppins_regular"
                    android:lineHeight="@dimen/_21ssp"
                    android:letterSpacing=".031"
                    app:layout_constraintTop_toBottomOf="@id/welcome_txt"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <EditText
                    android:id="@+id/email_text"
                    style="@style/custom_edit_text"
                    android:drawableStart="@drawable/custom_email_icon"
                    android:hint="@string/your_email"
                    android:inputType="textEmailAddress"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sign_in_txt"/>

                <EditText
                    android:id="@+id/password_text"
                    style="@style/custom_edit_text"
                    android:drawableStart="@drawable/custom_password_icon"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/email_text"/>

                <Button
                    android:id="@+id/sign_in_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in"
                    android:textAllCaps="false"
                    android:padding="@dimen/_12sdp"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing=".031"
                    android:lineHeight="@dimen/_21ssp"
                    android:backgroundTint="@color/primary_color"
                    android:layout_margin="@dimen/_16sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/password_text"/>

                <View
                    android:id="@+id/left_line"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    app:layout_constraintTop_toTopOf="@id/or_label"
                    app:layout_constraintBottom_toBottomOf="@id/or_label"
                    app:layout_constraintStart_toStartOf="@id/sign_in_btn"
                    app:layout_constraintEnd_toStartOf="@id/or_label"/>
                <TextView
                    android:id="@+id/or_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_16sdp"
                    android:text="@string/or"
                    android:textColor="@color/gray"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="@dimen/_12ssp"
                    android:letterSpacing=".031"
                    app:layout_constraintStart_toEndOf="@id/left_line"
                    app:layout_constraintTop_toBottomOf="@id/sign_in_btn"
                    app:layout_constraintEnd_toStartOf="@id/right_line"/>
                <View
                    android:id="@+id/right_line"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    app:layout_constraintStart_toEndOf="@id/or_label"
                    app:layout_constraintEnd_toEndOf="@id/sign_in_btn"
                    app:layout_constraintTop_toTopOf="@id/or_label"
                    app:layout_constraintBottom_toBottomOf="@id/or_label"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_with_google_btn"
                    style="@style/custom_button"
                    android:text="@string/login_with_google"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="start"
                    app:iconTint="@null"
                    app:cornerRadius="@dimen/_8sdp"
                    app:strokeWidth="@dimen/_2sdp"
                    app:strokeColor="@color/natural_light"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/or_label"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_with_facebook_btn"
                    style="@style/custom_button"
                    android:text="@string/login_with_facebook"
                    app:icon="@drawable/ic_facebook"
                    app:iconGravity="start"
                    app:iconTint="@null"
                    app:cornerRadius="@dimen/_8sdp"
                    app:strokeWidth="@dimen/_2sdp"
                    app:strokeColor="@color/natural_light"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/login_with_google_btn"/>

                <TextView
                    android:id="@+id/forgot_password_label"
                    style="@style/custom_text_clickable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:layout_margin="@dimen/_16sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/login_with_facebook_btn"/>
                <TextView
                    android:id="@+id/do_not_have_accont_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    android:text="@string/don_t_have_an_account"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginEnd="@dimen/_2sdp"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/poppins_regular"
                    android:letterSpacing=".031"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/forgot_password_label"
                    app:layout_constraintEnd_toStartOf="@id/register_label"/>
                <TextView
                    android:id="@+id/register_label"
                    style="@style/custom_text_clickable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register"
                    app:layout_constraintStart_toEndOf="@id/do_not_have_accont_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/do_not_have_accont_label"
                    app:layout_constraintBottom_toBottomOf="@id/do_not_have_accont_label"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>